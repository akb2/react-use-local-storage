{
  "name": "react-use-local-storage",
  "version": "1.0.0",
  "description": "A state hook with browser's localStorage",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean --out-dir dist --minify",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "react",
    "localStorage",
    "hook"
  ],
  "author": "akb2",
  "repository": {
    "type": "git",
    "url": "https://github.com/akb2/react-use-local-storage.git"
  },
  "bugs": {
    "url": "https://github.com/akb2/react-use-local-storage/issues"
  },
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}