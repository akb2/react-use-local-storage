{
  "name": "react-use-local-storage",
  "version": "1.0.0",
  "description": "A state hook with browser's localStorage",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js",
      "require": "./.dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean --out-dir .dist --minify",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [
    "react",
    "localStorage",
    "hook"
  ],
  "author": "akb2",
  "repository": {
    "type": "git",
    "url": "https://github.com/akb2/react-use-local-storage.git"
  },
  "bugs": {
    "url": "https://github.com/akb2/react-use-local-storage/issues"
  },
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@akb2/types-tools": "^1.3.0",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "@akb2/types-tools": "^1.3.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@akb2/types-tools": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  }
}